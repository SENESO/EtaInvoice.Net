<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EtaInvoice</AssemblyName>
    <RootNamespace>EtaInvoice</RootNamespace>
    <Version>1.1.0</Version>
    <Authors>Eslam Ashraf</Authors>
    <Description>A clean, modern .NET SDK for the Egyptian Tax Authority (ETA) e-invoicing APIs.</Description>
    <PackageId>EtaInvoice.Net</PackageId>
    <PackageTags>eta;einvoice;egypt;tax;einvoicing</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SENESO/EtaInvoice.Net</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/SENESO/EtaInvoice.Net</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>New: DeclineRejectionAsync and GetRecentDocumentsAsync endpoints, full XML API docs; dependencies updated (System.Text.Json 10, DI.Abstractions 10).</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
  </ItemGroup>


  <ItemGroup>
    <None Include="../../docs/icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
